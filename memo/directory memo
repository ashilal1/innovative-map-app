js/
  config.js        // 定数（URL/KEY, zoomなど）
  supabase.js      // Supabase client生成
  state.js         // グローバル状態（clickedLatLng, locked, myUserId）
  ui.js            // フォーム開閉/入力/プレビュー/ロック制御
